# Copy this file to .env.local and fill in the values for your Supabase project.
# .env.local is git-ignored. Never commit real keys.

# Supabase project URL (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key. This key is safe to ship to browsers;
# Row-Level Security policies protect the data.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Optional: notification delivery (set as Supabase Edge Function secrets, not here) ──
# Web push needs nothing: the deliver-notification function generates its VAPID
# keys on first use. Email and SMS switch on when these exist on the function:
#   RESEND_API_KEY=re_xxx            EMAIL_FROM="EmComm Planner <planner@example.org>"
#   TWILIO_ACCOUNT_SID=ACxxx         TWILIO_AUTH_TOKEN=xxx     TWILIO_FROM=+14045550100
#   APP_URL=https://emcommplanner.org   (links in messages; defaults to this)

# ── Optional: post the staffing roster to Google Drive as a Sheet (web app only) ──
# A public OAuth client id of type "Web application" with the Google Drive API
# enabled; see docs/GOOGLE_DRIVE.md. Leave empty to hide the feature.
VITE_GOOGLE_CLIENT_ID=
