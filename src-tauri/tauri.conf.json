{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmComm Planner",
  "version": "../package.json",
  "identifier": "org.kk4oda.emcomm-planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EmComm Planner",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.supabase.co https://*.tile.openstreetmap.org https://server.arcgisonline.com",
        "font-src": "'self' data:",
        "connect-src": "'self' https://*.supabase.co wss://*.supabase.co ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "KK4ODA",
    "copyright": "Copyright © KK4ODA",
    "category": "Utility",
    "shortDescription": "ARES emergency communications deployment planner",
    "longDescription": "Plan amateur radio emergency communications deployments: sites, equipment assignments, setup tasks and ICS 205 radio plans.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "EmComm Planner"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NjYzMkUzNUI3NUYzMUYKUldRZjgzVmI0ekptS0I3aEpQRVJWVjQvQURGQzRZWnhvUTBoeFh1L0lCcVkrWkxTdG8wQlRnY3UK",
      "endpoints": [
        "https://github.com/KK4ODA/emcomm-deployment-planner/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
